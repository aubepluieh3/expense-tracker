# e2e 테스트 계정. 이 파일을 .env.test.local 로 복사한 뒤 값을 채우세요.
# (.env.*.local 은 커밋되지 않습니다)
#
# 반드시 전용 계정을 쓰세요. 테스트는 매 라운드 시작에 이 계정의
# 거래를 전부 지우고 카테고리를 기본값으로 되돌립니다.
#
# Supabase URL / anon key 는 .env.local 을 그대로 씁니다.
# service_role 키는 필요 없고, 쓰면 안 됩니다 — RLS 를 우회하면
# 테스트가 검증해야 할 격리를 스스로 무너뜨립니다.

E2E_EMAIL=test@example.com
E2E_PASSWORD=

# 두 번째 계정 (선택). 세션 전환 캐시 유출 검증에만 씁니다 —
# 한 계정으로는 "다른 사용자의 데이터가 보이는지"를 물을 수 없습니다.
# 없으면 그 검증만 건너뜁니다.
#
# 이 계정은 읽기 전용으로만 다룹니다. 초기화하지도, 쓰지도 않습니다.
# E2E_EMAIL_2=test2@example.com
# E2E_PASSWORD_2=

# 개발 서버가 다른 주소면 지정 (기본 http://localhost:5173)
# E2E_BASE_URL=http://localhost:5173
